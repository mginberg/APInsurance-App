# Platinum App Environment Variables
# Copy this to .env and fill in your values

# Super Admin Credentials
SUPER_ADMIN_EMAIL=admin@platinum-app.com
SUPER_ADMIN_PASSWORD=changeme

# GoHighLevel API Credentials
GHL_API_KEY=your_ghl_api_key_here
GHL_LOCATION_ID=your_ghl_location_id_here
GHL_AGENT_FIELD_ID=your_ghl_agent_field_id_here
GHL_PREMIUM_FIELD_ID=your_ghl_premium_field_id_here
GHL_ADVANCE_STATUS_FIELD_ID=your_ghl_advance_status_field_id_here

# Optional: CallTools API Key (for billable hours tracking)
CALLTOOLS_API_KEY=your_calltools_api_key_here
